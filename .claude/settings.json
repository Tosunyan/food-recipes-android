{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/allow-safe-commands.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
