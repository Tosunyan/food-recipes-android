{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/allow-safe-commands.sh\"; [ -f \"$hook\" ] && bash \"$hook\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
